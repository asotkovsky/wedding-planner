DATABASE_URL=postgres://postgres:Postgr3s@localhost:5432/wedding_planner
# TLS: "verify" for AWS RDS (verifies the server certificate), "require" for encryption only, "false" for local Docker
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ANTHROPIC_API_KEY=
# Only needed if your API key isn't scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
